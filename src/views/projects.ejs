<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>
        <% const successMessages=flash('success'); %>
            <% const errorMessages=flash('error'); %>
        
                <% successMessages.forEach(message=> { %>
                    <div class="flash-success">
                        <%= message %>
                    </div>
                    <% }) %>
        
                        <% errorMessages.forEach(message=> { %>
                            <div class="flash-error">
                                <%= message %>
                            </div>
                            <% }) %>

        <% if (projects && projects.length> 0) { %>
            <ul class="projects-list">
                <% projects.forEach(project=> { %>
                    <li class="project-tile">
                        <h3>
                            <a href="/project/<%= project.project_id %>">
                                <%= project.title %>
                            </a>
                        </h3>

                        <p>
                            <strong>Organized by:</strong>
                            <a href="/organization/<%= project.organization_id %>">
                                <%= project.organization_name %>
                            </a>
                        </p>
                    </li>
                    <% }); %>
            </ul>
            <% } else { %>
                <p>No upcoming service projects found at this time. Check back later!</p>
                <% } %>
    </main>
<%- include('partials/footer') %>
<p><a href="/new-project">Add a New Service Project</a></p>