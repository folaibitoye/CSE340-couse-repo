<%- include('partials/header') %>
    <main class="category-details-container">
        <h1>
            <%= category.category_name %> Projects
        </h1>

        <h2>Available Service Opportunities</h2>

        <% if (projects && projects.length> 0) { %>
            <ul class="projects-list">
                <% projects.forEach(project=> { %>
                    <li class="project-tile">
                        <h3>
                            <a href="/project/<%= project.project_id %>">
                                <%= project.title %>
                            </a>
                        </h3>
                        <p>
                            <%= project.description %>
                        </p>
                        <p class="project-meta">
                            <strong>Organized by:</strong>
                            <%= project.organization_name %> |
                                <strong>Location:</strong>
                                <%= project.location %>
                        </p>
                    </li>
                    <% }); %>
            </ul>
            <% } else { %>
                <p>No service projects are currently filed under this category.</p>
                <% } %>

                    <p class="back-link">
                        <a href="/categories">&larr; Back to All Categories</a>
                    </p>
    </main>
    <%- include('partials/footer') %>